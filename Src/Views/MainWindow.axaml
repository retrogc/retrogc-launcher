<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:RetroGameCard.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RetroGameCard.ViewModels"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
        x:Class="RetroGameCard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Retro Game Card"
        Icon="/Assets/Icons/launcher.ico"
        Width="960" Height="540"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- Bigger base sizes than the shared theme (dialogs): this screen is read from a distance -->
        <Style Selector="TextBlock.label">
            <Setter Property="(v:PixelPerfect.FontSize)" Value="11" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="(v:PixelPerfect.FontSize)" Value="12" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="(v:PixelPerfect.FontSize)" Value="10" />
        </Style>

        <Style Selector="TextBlock.brand">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="(v:PixelPerfect.FontSize)" Value="18" />
        </Style>
        <Style Selector="TextBlock.game-title">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="(v:PixelPerfect.FontSize)" Value="26" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="3" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
        </Style>
        <Style Selector="TextBlock.clock">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
            <Setter Property="(v:PixelPerfect.FontSize)" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        </Style>

        <!-- Status box: colour follows the session state (waiting = yellow) -->
        <Style Selector="Border.status">
            <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BoxShadow" Value="3 3 0 0 #000000" />
        </Style>
        <Style Selector="Border.status Rectangle">
            <Setter Property="Fill" Value="{StaticResource YellowBrush}" />
        </Style>
        <Style Selector="Border.status TextBlock">
            <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
        </Style>
        <Style Selector="Border.status.running, Border.status.stopped">
            <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        </Style>
        <Style Selector="Border.status.running Rectangle, Border.status.stopped Rectangle">
            <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
        </Style>
        <Style Selector="Border.status.running TextBlock, Border.status.stopped TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        </Style>
        <Style Selector="Border.status.error">
            <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
        </Style>
        <Style Selector="Border.status.error Rectangle">
            <Setter Property="Fill" Value="{StaticResource RedBrush}" />
        </Style>
        <Style Selector="Border.status.error TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>

        <Style Selector="Rectangle.monitor">
            <Setter Property="Fill" Value="{StaticResource YellowBrush}" />
        </Style>
        <Style Selector="Rectangle.monitor.card">
            <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
        </Style>

        <!-- Cross-fade the cover when it changes -->
        <Style Selector="Image.cover">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- The whole screen scales with the window size (see MainWindow.UpdateScale) -->
        <LayoutTransformControl x:Name="ScaleRoot" ClipToBounds="True">
            <Grid ClipToBounds="True">
                <!-- ===== Ambient background: blurred cover art under a flat dark veil ===== -->
                <Image Classes="cover"
                       Source="{Binding Cover}"
                       Stretch="UniformToFill"
                       Opacity="{Binding HasCover, Converter={x:Static vm:Converters.BoolToOpacity}, ConverterParameter=0.3}"
                       Effect="blur(60)"
                       IsHitTestVisible="False" />
                <Border Background="#B3120E24" IsHitTestVisible="False" />
                <!-- CRT scanlines on the background and the cover art, under the text (PixelPerfect: whole screen pixels) -->
                <Border Background="{DynamicResource ScanlinesBrush}" Opacity="0.3" IsHitTestVisible="False" />

                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="40,30">

                    <!-- ===== Header ===== -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <TextBlock Classes="brand">
                                <Run Text="RETRO " Foreground="{StaticResource MagentaBrush}" />
                                <Run Text="GAME " Foreground="{StaticResource YellowBrush}" />
                                <Run Text="CARD" Foreground="{StaticResource CyanBrush}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Rectangle Classes="led monitor"
                                           Classes.card="{Binding HasCard}"
                                           Classes.pulse="{Binding IsWaiting}" />
                                <TextBlock Text="{Binding MonitorText}" Classes="label" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ClockText}" Classes="clock" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding DateText}" Classes="label" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- Rainbow stripe -->
                    <UniformGrid Grid.Row="1" Classes="stripe" Margin="0,0,0,24">
                        <Rectangle Fill="{StaticResource MagentaBrush}" />
                        <Rectangle Fill="{StaticResource OrangeBrush}" />
                        <Rectangle Fill="{StaticResource YellowBrush}" />
                        <Rectangle Fill="{StaticResource GreenBrush}" />
                        <Rectangle Fill="{StaticResource CyanBrush}" />
                        <Rectangle Fill="{StaticResource VioletBrush}" />
                    </UniformGrid>

                    <!-- ===== Main ===== -->
                    <!-- Square cover as tall as the row, details on the rest of the width -->
                    <v:SquareSplitPanel Grid.Row="2" Spacing="40" MaxSquareFraction="0.55">

                        <!-- Cover frame (square: covers are made square): border in the platform colour, hard pixel shadow -->
                        <Border Margin="0,0,6,6"
                                Background="{StaticResource SurfaceSunkenBrush}"
                                BorderBrush="{Binding Platform, Converter={x:Static vm:Converters.TextToAccentBrush}}"
                                BorderThickness="3"
                                BoxShadow="6 6 0 0 #000000">
                            <Grid ClipToBounds="True">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"
                                            IsVisible="{Binding !HasCover}">
                                    <PathIcon Data="{StaticResource IconSdCard}" Width="56" Height="56"
                                              Foreground="{StaticResource BorderStrongBrush}" />
                                    <TextBlock Text="{Binding IsWaiting, Converter={x:Static vm:Converters.BoolToText}, ConverterParameter='INSERT CARD|NO PREVIEW'}"
                                               Classes="label" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Image Classes="cover" Source="{Binding Cover}" Stretch="Uniform"
                                       Opacity="{Binding HasCover, Converter={x:Static vm:Converters.BoolToOpacity}}" />
                                <Border Background="{DynamicResource ScanlinesBrush}" Opacity="0.35" IsHitTestVisible="False" />

                                <!-- Caption bar: title and platform over the bottom of the cover -->
                                <Border VerticalAlignment="Bottom" Padding="14,10" Background="#E60D0A1A"
                                        BorderBrush="{Binding Platform, Converter={x:Static vm:Converters.TextToAccentBrush}}"
                                        BorderThickness="0,3,0,0"
                                        IsVisible="{Binding HasCard}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Title}" Classes="label" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Platform}" Classes="label"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Platform, Converter={x:Static vm:Converters.TextToAccentBrush}}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Game details -->
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                            <!-- Title block: hidden items take no space (unlike grid rows) -->
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="12">
                                    <Border Classes="chip" HorizontalAlignment="Left"
                                            Background="{Binding Platform, Converter={x:Static vm:Converters.TextToSoftBrush}}"
                                            BorderBrush="{Binding Platform, Converter={x:Static vm:Converters.TextToAccentBrush}}"
                                            IsVisible="{Binding Platform, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Platform}" v:PixelPerfect.FontSize="12"
                                                   Foreground="{Binding Platform, Converter={x:Static vm:Converters.TextToAccentBrush}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Classes="game-title" />
                                </StackPanel>

                                <TextBlock Text="{Binding Byline}" Classes="label" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding Byline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <ItemsControl ItemsSource="{Binding Tags}"
                                              IsVisible="{Binding HasTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="10" LineSpacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip" MaxWidth="420"
                                                    Background="{Binding Converter={x:Static vm:Converters.TextToSoftBrush}}"
                                                    BorderBrush="{Binding Converter={x:Static vm:Converters.TextToAccentBrush}}">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{Binding Converter={x:Static vm:Converters.TextToAccentBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Description}" Classes="body" FontSize="18" LineHeight="28"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,14,0" />
                            </ScrollViewer>

                            <!-- Status -->
                            <StackPanel Grid.Row="2" Spacing="14">
                                <Border Classes="banner error" IsVisible="{Binding HasError}" MaxHeight="120">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <PathIcon Data="{StaticResource IconWarning}" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                                                             TextWrapping="Wrap" FontSize="15"
                                                             Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                </Border>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Classes="status" Margin="0,0,3,3"
                                            Classes.running="{Binding IsRunning}"
                                            Classes.stopped="{Binding IsIdle}"
                                            Classes.error="{Binding IsError}">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Rectangle Classes="led"
                                                       Classes.pulse="{Binding IsBusy}" />
                                            <TextBlock Text="{Binding StateLabel}" Classes="label" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding StateDetail}"
                                               Classes="hint" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                             Value="{Binding ProgressValue}"
                                             Maximum="100" Height="14" />
                            </StackPanel>
                        </Grid>
                    </v:SquareSplitPanel>

                    <!-- ===== Footer ===== -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,22,0,0">
                        <TextBlock Text="{Binding HintText}" Classes="label" v:PixelPerfect.FontSize="10"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Rectangle Classes="led" Width="6" Height="6" Fill="{StaticResource MagentaBrush}" />
                            <TextBlock Text="{Binding LauncherVersionText}" Classes="mono" FontSize="18"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Rectangle Classes="led" Width="6" Height="6"
                                       Fill="{Binding HasData, Converter={x:Static vm:Converters.BoolToBrush}}" />
                            <TextBlock Text="{Binding DataVersionText}" Classes="mono" FontSize="18"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </LayoutTransformControl>
    </Panel>
</Window>
