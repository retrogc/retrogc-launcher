<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>Src\app.manifest</ApplicationManifest>
        <AssemblyName>retrogc-launcher</AssemblyName>
        <!-- Overridden at publish time (release.yml: -p:Version=X.Y.Z); installer cards compare it -->
        <Version>0.0.0</Version>
        <ApplicationIcon>Src\Assets\Icons\launcher.ico</ApplicationIcon>
        <RootNamespace>RetroGameCard</RootNamespace>
        <!-- Compiled bindings are trim-safe (release builds are trimmed) and are checked at build time -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <!-- Gamepads (main screen): SDL3 bindings + the native SDL3 library for win-x64 / linux-x64 -->
        <PackageReference Include="SDL3-CS" Version="3.4.20" />
        <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Src\Assets\**"/>
        <AvaloniaResource Include="Src\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include=".github\workflows\release.yml"/>
    </ItemGroup>
</Project>
