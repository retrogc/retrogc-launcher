<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="180"
        x:Class="RetroGameCard.Controls.DownloadProgressWindow"
        Title="Downloading RetroArch"
        Width="440" Height="180"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="StatusText" Text="Starting download..." FontSize="14" />
        <ProgressBar x:Name="ProgressBar"
                     Minimum="0" Maximum="100" Value="0"
                     Height="20"
                     ShowProgressText="True"
                     ProgressTextFormat="{}{1:0}%" />
        <TextBlock x:Name="DetailText" FontSize="12" Opacity="0.7" />
        <Button Content="Cancel"
                HorizontalAlignment="Right"
                Click="OnCancelClick" />
    </StackPanel>
</Window>