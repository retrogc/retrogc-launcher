<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:RetroGameCard.Views">

    <!--
        "16-bit console menu" theme: flat colours only (no gradients), square corners, 2px borders,
        hard pixel shadows and a pixel font for display text.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ================= Palette ================= -->
            <SolidColorBrush x:Key="BgBrush" Color="#120E24" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1633" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#241D42" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0D0A1A" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2C2550" />
            <SolidColorBrush x:Key="BorderBrush" Color="#3A3163" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#544A8A" />
            <SolidColorBrush x:Key="ShadowBrush" Color="#000000" />

            <SolidColorBrush x:Key="TextBrush" Color="#F1EEFF" />
            <SolidColorBrush x:Key="TextStrongBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#C2BBE3" />
            <SolidColorBrush x:Key="TextDimBrush" Color="#9790BD" />
            <SolidColorBrush x:Key="TextFaintBrush" Color="#6B6494" />
            <!-- Text on a bright accent fill -->
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#120E24" />

            <!-- Arcade accents + their dark tints (chip / banner backgrounds) -->
            <SolidColorBrush x:Key="MagentaBrush" Color="#FF3E8A" />
            <SolidColorBrush x:Key="MagentaSoftBrush" Color="#3A1534" />
            <SolidColorBrush x:Key="CyanBrush" Color="#2EE6D6" />
            <SolidColorBrush x:Key="CyanSoftBrush" Color="#113A45" />
            <SolidColorBrush x:Key="YellowBrush" Color="#FFD23F" />
            <SolidColorBrush x:Key="YellowSoftBrush" Color="#3A3022" />
            <SolidColorBrush x:Key="OrangeBrush" Color="#FF8C42" />
            <SolidColorBrush x:Key="OrangeSoftBrush" Color="#3B2228" />
            <SolidColorBrush x:Key="VioletBrush" Color="#9B6CFF" />
            <SolidColorBrush x:Key="VioletSoftBrush" Color="#2A1F55" />
            <SolidColorBrush x:Key="GreenBrush" Color="#6BE675" />
            <SolidColorBrush x:Key="GreenSoftBrush" Color="#18352E" />
            <SolidColorBrush x:Key="RedBrush" Color="#FF5A5F" />
            <SolidColorBrush x:Key="RedSoftBrush" Color="#3D1726" />

            <!-- Roles -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3E8A" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF6AA6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2EE6D6" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#7FF3EA" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#113A45" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#1E8C88" />
            <SolidColorBrush x:Key="InfoBrush" Color="#9B6CFF" />
            <SolidColorBrush x:Key="WarnBrush" Color="#FFD23F" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF5A5F" />

            <!-- Segmented "loading blocks" fills for progress bars -->
            <DrawingBrush x:Key="SegmentsCyanBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,10,64">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H10 V64 H0 Z" />
                        <GeometryDrawing Brush="#2EE6D6" Geometry="M0,0 H7 V64 H0 Z" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="SegmentsVioletBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,10,64">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H10 V64 H0 Z" />
                        <GeometryDrawing Brush="#9B6CFF" Geometry="M0,0 H7 V64 H0 Z" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="SegmentsMagentaBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,14,64">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V64 H0 Z" />
                        <GeometryDrawing Brush="#FF3E8A" Geometry="M0,0 H10 V64 H0 Z" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <!-- ================= Fonts ================= -->
            <FontFamily x:Key="PixelFont">avares://retrogc-launcher/Assets/Fonts#Press Start 2P</FontFamily>
            <FontFamily x:Key="MonoFont">avares://retrogc-launcher/Assets/Fonts#VT323</FontFamily>

            <!-- ================= Icons (Material Design, Apache 2.0) ================= -->
            <StreamGeometry x:Key="IconCloudDownload">M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderOpen">M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconInfo">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
            <StreamGeometry x:Key="IconSdCard">M18 2h-8L4.02 8 4 20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-6 6h-2V4h2v4zm3 0h-2V4h2v4zm3 0h-2V4h2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconGamepad">M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
            <StreamGeometry x:Key="IconArchive">M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ================= Window ================= -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BgBrush}" />
        <Setter Property="FontFamily" Value="Inter, Arial, sans-serif" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- ================= Typography ================= -->
    <!-- Pixel font: headings, labels, chips, buttons. Body text stays in Inter for long reading. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="(v:PixelPerfect.FontSize)" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="(v:PixelPerfect.FontSize)" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="(v:PixelPerfect.FontSize)" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="(v:PixelPerfect.FontSize)" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- ================= Surfaces ================= -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="4 4 0 0 #000000" />
    </Style>

    <!-- Rainbow stripe: solid colour segments, like old console boxes -->
    <Style Selector="UniformGrid.stripe">
        <Setter Property="Rows" Value="1" />
        <Setter Property="Height" Value="4" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="(v:PixelPerfect.FontSize)" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.chip.accent">
        <Setter Property="Background" Value="{StaticResource MagentaSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
    </Style>
    <Style Selector="Border.chip.accent > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}" />
    </Style>
    <Style Selector="Border.chip.yellow">
        <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
    </Style>
    <Style Selector="Border.chip.yellow > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
    </Style>

    <!-- Square icon box (settings, installer) -->
    <Style Selector="Border.icon-box">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#000000" />
    </Style>
    <Style Selector="Border.icon-box > PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
    </Style>

    <!-- Banners: info / ok / warning / error -->
    <Style Selector="Border.banner">
        <Setter Property="Background" Value="{StaticResource VioletSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VioletBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.banner PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{StaticResource VioletBrush}" />
    </Style>
    <Style Selector="Border.banner TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.banner.ok">
        <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Border.banner.ok PathIcon">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    </Style>
    <Style Selector="Border.banner.warning">
        <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
    </Style>
    <Style Selector="Border.banner.warning PathIcon">
        <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
    </Style>
    <Style Selector="Border.banner.error">
        <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
    </Style>
    <Style Selector="Border.banner.error PathIcon">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
    </Style>

    <!-- ================= Buttons ================= -->
    <!-- Flat key with a hard shadow; pressing it pushes it into the shadow. Fluent styles the
         template's presenter on hover/press, so those states target it too. -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="(v:PixelPerfect.FontSize)" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="3 3 0 0 #000000" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2E2654" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="translate(3px,3px)" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>

    <!-- Icon + label buttons: centre the label on the icon (it would draw at the top of the row) -->
    <Style Selector="Button StackPanel > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#000000" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="Padding" Value="20,11" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="#000000" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D92F72" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>

    <!-- ================= Inputs ================= -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- ================= Progress ================= -->
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource SegmentsCyanBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ProgressBar.large">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource SegmentsMagentaBrush}" />
    </Style>
    <Style Selector="ProgressBar.info">
        <Setter Property="Foreground" Value="{StaticResource SegmentsVioletBrush}" />
    </Style>

    <!-- ================= Status LED (square pixel) ================= -->
    <Style Selector="Rectangle.led">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
    </Style>
    <!-- Blinks in steps, like an old LED -->
    <Style Selector="Rectangle.led.pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="49%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.2" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.2" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Rotating arc used as a busy indicator (needs a RotateTransform as RenderTransform) -->
    <Style Selector="Arc.spinner">
        <Setter Property="Stroke" Value="{StaticResource MagentaBrush}" />
        <Setter Property="StrokeThickness" Value="6" />
        <Setter Property="StrokeLineCap" Value="Square" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="90" />
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
