<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>Src\app.manifest</ApplicationManifest>
        <AssemblyName>retrogc-launcher</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Src\Assets\**"/>
        <AvaloniaResource Include="Src\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include=".github\workflows\release.yml"/>
    </ItemGroup>
</Project>