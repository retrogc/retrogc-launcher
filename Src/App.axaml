<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RetroGameCard.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Icons/tray.png" ToolTipText="RetroGameCard" Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open" Icon="/Assets/Icons/open.png" Click="OnOpenClicked" />
                        <NativeMenuItem Header="Settings" Icon="/Assets/Icons/settings.png" Click="OnSettingsClicked" />
                        <NativeMenuItem Header="Exit" Icon="/Assets/Icons/exit.png" Click="OnExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>