<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="240"
        xmlns:rgc="clr-namespace:RetroGameCard"
        x:Class="RetroGameCard.MainWindow"
        Title="RetroGameCard" Width="320" Height="240">
    <!--
    <Design.DataContext>
        <rgc:AppContext />
    </Design.DataContext>
    -->
    <Grid RowDefinitions="Auto,*" Margin="0">
        <Image x:Name="PreviewImage" Grid.Row="1"
               Margin="0,0,0,0"
               Stretch="Uniform" />
    </Grid>
</Window>